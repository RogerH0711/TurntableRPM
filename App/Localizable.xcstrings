    "記下原廠規格與傳動鏈尺寸之後，量測結果就能自動跟規格比對。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trägst du Werksangabe und Antriebsmaße ein, werden Messungen automatisch damit verglichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you record the factory spec and drive-chain dimensions, measurements are compared against them automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メーカー規格と駆動系の寸法を登録しておくと、測定結果が自動で規格と比較されます。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記下原廠規格與傳動鏈尺寸之後，量測結果就能自動跟規格比對。"
          }
        }
      }
    },
