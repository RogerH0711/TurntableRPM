            "state" : "translated",
            "value" : "%@ ist die stärkste Komponente (%lld%%), aber es gibt weitere Quellen — beides ist vorhanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is the strongest component (%lld%%), but other sources contribute too — it is a mix of both."
          }
        },
        "ja" : {
