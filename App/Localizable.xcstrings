    "每圈兩次 —— 盤面橢圓或主軸兩點磨損" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2×/Umdrehung — unrunder Teller oder Verschleiß an zwei Stellen der Achse"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2×/rev — an out-of-round platter, or two-point wear on the spindle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回転に2回 —— 円盤が楕円、またはスピンドルの2点摩耗"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每圈兩次 —— 盤面橢圓或主軸兩點磨損"
          }
        }
      }
    },
    "每圈兩次 —— 盤面橢圓或主軸兩點磨損。但如果上面的每圈一次很大，這根多半只是它的諧波，先把偏心降下來再看。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2×/Umdrehung — ein unrunder Teller oder Verschleiß an zwei Stellen der Achse. Ist die 1×/Umdrehung oben aber groß, ist dies meist nur deren Oberwelle: Erst die Exzentrizität verringern, dann erneut schauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2×/rev — an out-of-round platter, or two-point wear on the spindle. But if the 1×/rev above is large, this is most likely just its harmonic: bring the eccentricity down first, then look again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回転に2回 —— 円盤が楕円、またはスピンドルの2点摩耗。ただし上の「1回転に1回」が大きい場合、これはたいていその高調波です。先に偏心を下げてから見直してください。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每圈兩次 —— 盤面橢圓或主軸兩點磨損。但如果上面的每圈一次很大，這根多半只是它的諧波，先把偏心降下來再看。"
          }
        }
      }
    },
