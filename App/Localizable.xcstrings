    "量測條件" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messbedingungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Measurement conditions"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定条件"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "量測條件"
          }
        }
      }
    },
    "量測畫面會反向旋轉，讓內容在轉動中看起來靜止。加的資訊愈多、字就得愈小，因為所有內容都必須落在螢幕的內接圓裡。" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Messbildschirm dreht gegen, damit sein Inhalt bei drehendem Teller still zu stehen scheint. Je mehr angezeigt wird, desto kleiner muss die Schrift werden — alles muss in den dem Display einbeschriebenen Kreis passen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The measuring screen counter-rotates so its contents look still while the platter spins. The more you add, the smaller the text has to be, because everything must fit inside the circle inscribed in the screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測定画面は逆方向に回転するので、円盤が回っていても内容が静止して見えます。表示を増やすほど文字は小さくなります —— すべての内容が画面に内接する円の中に収まる必要があるためです。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "量測畫面會反向旋轉，讓內容在轉動中看起來靜止。加的資訊愈多、字就得愈小，因為所有內容都必須落在螢幕的內接圓裡。"
          }
        }
      }
    },
    "量測畫面顯示什麼" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was der Messbildschirm zeigt"
          }
        },
        "en" : {
